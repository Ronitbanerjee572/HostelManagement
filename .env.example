# Example environment variables for development and deployment
# Frontend (Vite) - must be prefixed with VITE_
VITE_API_BASE=http://localhost:5000/api

# Backend - Oracle APEX base URL used by the backend proxy
ORACLE_BASE_URL=https://your-oracle-apex-host.example.com

# Any other sensitive keys should be set in the deployment platform (Vercel) or local .env files
